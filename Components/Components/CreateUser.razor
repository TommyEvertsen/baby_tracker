@using BabyTracker.Data
@using BabyTracker.Models
@using BabyTracker.Services
@inject AppDbContext DbContext
@inject UserService UserService

<div class="createUserWrapper">
    <div class="createUser">
        <div class="createUserTop">
             <button class="closeButton" @onclick="OnClose">x</button>
          
        </div>
        <div class="createUserContent">
              <h3>Create User</h3>
            <input placeholder="Name" @bind="_name" />
            <input placeholder="Password" type="password" @bind="_password" />
            <div class="createUserButtonWrapper">
                <button @onclick="HandleCreate" class="logInButton">Create</button>
            </div>
        </div>
        
       

        @if (!string.IsNullOrEmpty(_message))
        {
            <p>@_message</p>
        }

        
        
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string _name = string.Empty;
    private string _password = string.Empty;
    private string _message = string.Empty;

    private async Task HandleCreate()
    {
        if (string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_password))
        {
            _message = "❌ Name and password are required.";
            return;
        }

        var user = new User { Name = _name };
        user.PasswordHash = UserService.HashPassword(user, _password);

        DbContext.Users.Add(user);
        await DbContext.SaveChangesAsync();

        _message = $"✅ User '{user.Name}' created with ID {user.Id}!";
        _name = string.Empty;
        _password = string.Empty;
    }
}